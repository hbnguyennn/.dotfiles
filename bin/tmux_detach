#!/bin/bash
#
# tmux_detach - List all tmux sessions and detach the one you pick
# Usage   : tmux_detach
#
# - Uses fzf for interactive selection if available
# - Falls back to a numbered menu otherwise
# - Works from inside or outside tmux

set -eu

if ! command -v tmux >/dev/null 2>&1; then
    echo "[Error] tmux not found in PATH" >&2
    exit 1
fi

# No server running at all
if ! tmux list-sessions >/dev/null 2>&1; then
    echo "[INFO] No tmux sessions found."
    exit 0
fi

# Collect sessions: "name: (N windows) [attached/detached]"
sessions="$(tmux list-sessions -F '#{session_name} | windows: #{session_windows} | attached: #{session_attached}')"

pick=""
if command -v fzf >/dev/null 2>&1; then
    pick="$(echo "$sessions" | fzf --prompt 'Detach session: ' --nth 1..)"
else
    echo "Available tmux sessions:"
    idx=0
    while IFS= read -r line; do
        idx=$((idx + 1))
        printf "  %-3d %s\n" "$idx" "$line"
    done <<< "$sessions"
    printf "Select session to detach [1-%d] (empty to cancel): " "$idx"
    read -r choice
    [[ -z "${choice}" ]] && exit 0
    if ! [[ "${choice}" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > idx )); then
        echo "[Error] Invalid choice: ${choice}" >&2
        exit 1
    fi
    pick="$(echo "$sessions" | sed -n "${choice}p")"
fi

[[ -z "${pick}" ]] && { echo "[INFO] Cancelled."; exit 0; }

# "name | windows: ... | attached: ..." -> name
name="${pick%% |*}"

if tmux detach-session -t "${name}"; then
    echo "[INFO] Detached session '${name}'."
else
    echo "[Error] Failed to detach session '${name}'." >&2
    exit 1
fi
